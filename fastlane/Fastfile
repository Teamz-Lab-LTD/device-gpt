default_platform(:android)

AAB_PATH = "app/build/outputs/bundle/release/app-release.aab"
MAPPING_PATH = "app/build/outputs/mapping/release/mapping.txt"

SUBMODULE_ROOT = "teamz-company-automation"
GEMINI_SCRIPT = "#{SUBMODULE_ROOT}/py/aso/aso-gemini-edit.py"
ENHANCED_DIR = "automation_data/play-screenshots/enhanced"
DEFAULT_ENHANCE_PROMPT = <<~PROMPT.strip.gsub("\n", " ")
  Enhance this Google Play Store screenshot of DeviceGPT (an Android device diagnostic app).
  Keep all UI content pixel-perfect — do not redraw the phone UI.
  Place the raw phone screen inside a photorealistic Google Pixel 8 Pro device frame, centered on a
  solid teal-to-dark background (no gradients, no radial glows, no sparkles).
  Add a bold headline above the device in clean sans-serif, high-contrast text that complements
  the background (WCAG AA+). Keep the headline short (max 5 words).
  ABSOLUTELY NO emoji, NO chart icons, NO sparkles, NO fake app store badges.
  Output 1080x1920 portrait.
PROMPT

platform :android do
  # --- Build + upload lanes --------------------------------------------------

  desc "Pre-release safety gate — runs unit tests + ad-pipeline safety guards. Blocks any release lane if a known regression pattern is detected (test ad ID typos, missing geo suppression, broken Compose render, throttle-too-tight, native ad viewability bug, etc)."
  lane :preflight do
    # --tests filter requires a CONCRETE Test task (e.g. testDebugUnitTest),
    # not the umbrella :app:test meta-task. testDebugUnitTest covers our
    # AdPipelineSafetyTest + NativeAdConfigDefaultsTest + NativeAdViewabilityTest
    # in app/src/test/. NativeAdViewabilityTest is the 2026-06-15 guard against
    # the Compose-asset-slot regression that caused the 1-year 98% show-rate bug.
    gradle(
      task: ":app:testDebugUnitTest",
      flags: "--tests *AdPipelineSafetyTest* --tests *NativeAdConfigDefaultsTest* --tests *NativeAdViewabilityTest*"
    )
    UI.success "✅ Ad-pipeline safety gate passed. No known regression patterns detected."
  end

  desc "Build release AAB"
  lane :build do
    preflight
    gradle(task: "clean")
    gradle(task: "bundle", build_type: "Release")
  end

  desc "Upload AAB to internal testing track (draft)"
  lane :internal do
    build
    upload_to_play_store(
      track: "internal", aab: AAB_PATH, mapping: MAPPING_PATH,
      release_status: "draft",
      skip_upload_metadata: true, skip_upload_images: true, skip_upload_screenshots: true
    )
  end

  desc "Upload AAB to closed beta track (draft)"
  lane :beta do
    build
    upload_to_play_store(
      track: "beta", aab: AAB_PATH, mapping: MAPPING_PATH,
      release_status: "draft",
      skip_upload_metadata: true, skip_upload_images: true, skip_upload_screenshots: true
    )
  end

  desc "Promote internal build to beta (no rebuild)"
  lane :promote_to_beta do
    upload_to_play_store(
      track: "internal", track_promote_to: "beta",
      skip_upload_apk: true, skip_upload_aab: true,
      skip_upload_metadata: true, skip_upload_images: true,
      skip_upload_screenshots: true, skip_upload_changelogs: true
    )
  end

  desc "Promote existing internal release to production at 10% staged rollout (sends for Play review). No rebuild — reuses the internal AAB. Staged rollout is safer than 100% — Play accepts even when new AAB has narrower device coverage than current production."
  lane :promote_to_production do
    upload_to_play_store(
      track: "internal", track_promote_to: "production",
      release_status: "inProgress",     # in-review + staged rollout
      rollout: "0.1",                    # 10% — bump to 1.0 manually after review
      skip_upload_apk: true, skip_upload_aab: true,
      skip_upload_metadata: true, skip_upload_images: true,
      skip_upload_screenshots: true, skip_upload_changelogs: true
    )
    UI.success "✅ Internal build promoted to production at 10% rollout (in review). Bump to 100% in Play Console after review clears."
  end

  desc "Same as promote_to_production but uploads as DRAFT — appears in Play Console UI for manual review/release with warnings (use when staged rollout is also rejected)."
  lane :promote_to_production_draft do
    upload_to_play_store(
      track: "internal", track_promote_to: "production",
      release_status: "draft",
      skip_upload_apk: true, skip_upload_aab: true,
      skip_upload_metadata: true, skip_upload_images: true,
      skip_upload_screenshots: true, skip_upload_changelogs: true
    )
    UI.success "✅ Promoted to production as DRAFT. Open Play Console → Production → Review and Release manually."
  end

  desc "ONE-SHOT release: build → upload to internal → promote to production (sends for Play review). Same AAB on both tracks."
  lane :release_full do
    internal
    promote_to_production
  end

  desc "Upload AAB to production (draft, 10% rollout)"
  lane :production do
    build
    upload_to_play_store(
      track: "production", aab: AAB_PATH, mapping: MAPPING_PATH,
      release_status: "draft", rollout: "0.1",
      skip_upload_metadata: true, skip_upload_images: true, skip_upload_screenshots: true
    )
  end

  desc "Full production release — AAB + all 17 locales' metadata + screenshots + featureGraphic + changelogs. Submits to Production track as draft (no rollout) for manual review/release in Play Console."
  lane :production_full do
    build
    upload_to_play_store(
      track: "production", aab: AAB_PATH, mapping: MAPPING_PATH,
      release_status: "draft",
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      skip_upload_changelogs: false,
      validate_only: false
    )
  end

  desc "Full production release — same as production_full but submits as COMPLETED (sends for Play review immediately). Use when ready to actually ship."
  lane :production_release do
    build
    upload_to_play_store(
      track: "production", aab: AAB_PATH, mapping: MAPPING_PATH,
      release_status: "completed",
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      skip_upload_changelogs: false,
      validate_only: false
    )
  end

  desc "Validate Play Store credentials"
  lane :validate do
    validate_play_store_json_key
  end

  # --- Metadata + screenshots ------------------------------------------------

  desc "Download current store listing + screenshots from Play Console"
  lane :fetch_store do
    # supply init must run from project root, otherwise it nests under fastlane/fastlane/
    Dir.chdir("..") do
      sh("bundle exec fastlane supply init --package_name #{ENV['TEAMZ_PLAY_PACKAGE_NAME'] || 'com.teamz.lab.debugger'}")
    end
    UI.success("Store listing downloaded to fastlane/metadata/android/")
    UI.message("Raw phone screenshots: fastlane/metadata/android/*/images/phoneScreenshots/")
  end

  desc "Enhance raw Play screenshots via Gemini Nano Banana (free tier). Usage: fastlane enhance_screenshots locale:en-US"
  lane :enhance_screenshots do |options|
    locale = options[:locale] || "en-US"
    prompt = options[:prompt] || DEFAULT_ENHANCE_PROMPT
    kinds = options[:kinds] || "phone"  # phone | tablet7 | tablet10 | all

    kind_map = {
      "phone"    => "phoneScreenshots",
      "tablet7"  => "sevenInchScreenshots",
      "tablet10" => "tenInchScreenshots"
    }
    targets = (kinds == "all") ? kind_map.values : [kind_map[kinds]].compact
    UI.user_error!("Unknown kinds: #{kinds}") if targets.empty?

    unless File.exist?(GEMINI_SCRIPT)
      UI.user_error!("Missing #{GEMINI_SCRIPT}. Did you initialize the submodule?")
    end

    targets.each do |kind|
      src_dir = "fastlane/metadata/android/#{locale}/images/#{kind}"
      out_dir = "#{ENHANCED_DIR}/#{locale}/#{kind}"
      unless Dir.exist?(src_dir)
        UI.important("Skipping #{kind}: no raw screenshots at #{src_dir}. Run `fastlane fetch_store` first.")
        next
      end
      FileUtils.mkdir_p(out_dir)
      images = Dir.glob("#{src_dir}/*.{png,jpg,jpeg}").sort
      if images.empty?
        UI.important("No images found in #{src_dir}")
        next
      end
      UI.success("Enhancing #{images.size} #{kind} screenshots → #{out_dir}")
      images.each do |src|
        basename = File.basename(src, ".*") + ".png"
        out = "#{out_dir}/#{basename}"
        sh "python3 '#{GEMINI_SCRIPT}' --prompt #{prompt.shellescape} --image '#{src}' --output '#{out}'"
      end
    end

    UI.success("Done. Review outputs in #{ENHANCED_DIR}/#{locale}/")
    UI.message("To push: `fastlane push_screenshots locale:#{locale}`")
  end

  desc "Copy enhanced screenshots into Fastlane structure and upload to Play Console"
  lane :push_screenshots do |options|
    locale = options[:locale] || "en-US"
    dry_run = options[:dry_run] == "true"

    Dir.glob("#{ENHANCED_DIR}/#{locale}/*").each do |kind_dir|
      kind = File.basename(kind_dir)
      dest = "fastlane/metadata/android/#{locale}/images/#{kind}"
      FileUtils.mkdir_p(dest)
      # Wipe stale enhanced files (preserve anything still in source dir)
      Dir.glob("#{dest}/*").each { |f| File.delete(f) if File.file?(f) }
      Dir.glob("#{kind_dir}/*.{png,jpg,jpeg}").each do |src|
        FileUtils.cp(src, "#{dest}/#{File.basename(src)}")
      end
      UI.success("Staged #{kind} for upload from #{kind_dir}")
    end

    if dry_run
      UI.important("Dry run — skipping upload_to_play_store")
      next
    end

    upload_to_play_store(
      skip_upload_apk: true, skip_upload_aab: true,
      skip_upload_metadata: true, skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: false
    )
  end

  desc "Upload text metadata only (title, short/long description) — no screenshots, no AAB"
  lane :push_metadata do
    upload_to_play_store(
      skip_upload_apk: true, skip_upload_aab: true,
      skip_upload_changelogs: true,
      skip_upload_images: true, skip_upload_screenshots: true
    )
  end
end
