    <!-- Category: how it is measured. Bangla says what it means for the person, not the formula. -->
    <string name="lb_cat_how_power_efficiency">Based on total power consumption (Watts) measured using Android BatteryManager API. Lower power usage = better rank.</string>
    <string name="lb_cat_how_cpu_performance">Based on CPU benchmark scores and processing speed. Higher performance = better rank.</string>
    <string name="lb_cat_how_camera_efficiency">Based on power consumed per photo taken. Lower power per photo = better rank.</string>
    <string name="lb_cat_how_display_efficiency">Based on screen brightness vs power consumption ratio. Higher brightness with lower power = better rank.</string>
    <string name="lb_cat_how_health_score">Based on overall device health metrics including battery health, storage, and system performance.</string>
    <string name="lb_cat_how_power_trend">Based on power consumption trends over time. Devices showing improvement = better rank.</string>
    <string name="lb_cat_how_component_optimization">Based on balanced power distribution across CPU, GPU, Display, and Network components.</string>
    <string name="lb_cat_how_thermal_efficiency">Based on device temperature during heavy usage. Cooler devices = better rank.</string>
    <string name="lb_cat_how_performance_consistency">Based on frame rate stability and absence of lag. Smoother performance = better rank.</string>
    <string name="lb_cat_how_app_power_monitoring">Based on screen time from Android UsageStats. Android does not expose per-app battery draw to third-party apps, so this ranks usage, not battery.</string>
    <string name="lb_cat_how_best_device" formatted="false">Based on composite score across all categories using market-research-based weights. Power Efficiency (22%), CPU Performance (18%), Thermal Efficiency (15%), Performance Consistency (14%), Health Score (12%), Component Optimization (8%), Power Trend (5%), Display Efficiency (4%), Camera Efficiency (2%).</string>

