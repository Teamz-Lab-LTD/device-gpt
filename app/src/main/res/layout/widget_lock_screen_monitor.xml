<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FF1D1F25">

    <!-- Most Important: Health Score (Psychological Trigger) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/widget_health_score"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mx_widget_health_none"
            android:textColor="#FFD9FE06"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mx_widget_streak_placeholder"
            android:textColor="#FFD9FE06"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Critical Alert/Issue (Urgency Trigger) -->
    <TextView
        android:id="@+id/widget_alert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FFFF6B6B"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        android:paddingBottom="6dp"
        android:visibility="gone" />

    <!-- Key Metrics Row 1 (Most Important) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widget_battery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mx_widget_battery_placeholder"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_thermal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mx_widget_temp_placeholder"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_ram"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mx_widget_ram_placeholder"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:gravity="end"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Key Metrics Row 2 (Additional Info) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widget_storage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mx_widget_disk_placeholder"
            android:textColor="#FFD9D9D9"
            android:textSize="9sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_network"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mx_widget_net_placeholder"
            android:textColor="#FFD9D9D9"
            android:textSize="9sp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_power"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mx_widget_drain_placeholder"
            android:textColor="#FFD9D9D9"
            android:textSize="9sp"
            android:gravity="end"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Key Metrics Row 3 (CPU & FPS) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widget_cpu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mx_widget_cpu_placeholder"
            android:textColor="#FFD9D9D9"
            android:textSize="9sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_fps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mx_widget_fps_placeholder"
            android:textColor="#FFD9D9D9"
            android:textSize="9sp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mx_widget_status_placeholder"
            android:textColor="#FFD9D9D9"
            android:textSize="9sp"
            android:gravity="end"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Compelling CTA (Psychological Trigger to Click) -->
    <TextView
        android:id="@+id/widget_cta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/mx_widget_cta_open"
        android:textColor="#FFD9FE06"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="4dp" />

    <!-- Update Time -->
    <TextView
        android:id="@+id/widget_last_update"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#99FFFFFF"
        android:textSize="9sp"
        android:gravity="end"
        android:paddingTop="2dp" />

</LinearLayout>
