<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FF1D1F25">

    <!-- Most Important: Health Score (Psychological Trigger) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/widget_health_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_dg_health"
            android:tint="#FFD9FE06" />

        <TextView
            android:id="@+id/widget_health_score"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mx_widget_health_none"
            android:textColor="#FFD9FE06"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mx_widget_streak_placeholder"
            android:textColor="#FFD9FE06"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Critical Alert/Issue (Urgency Trigger) -->
    <LinearLayout
        android:id="@+id/widget_alert_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_alert_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="4dp"
            android:layout_marginTop="1dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_dg_warning"
            android:tint="#FFFF6B6B" />

        <TextView
            android:id="@+id/widget_alert"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="#FFFF6B6B"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Key Metrics Row 1 (Most Important) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_battery_icon"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginEnd="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_dg_battery"
                android:tint="#FFFFFFFF" />

            <TextView
                android:id="@+id/widget_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mx_widget_battery_placeholder"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_thermal_icon"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginEnd="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_dg_temperature"
                android:tint="#FFFFFFFF" />

            <TextView
                android:id="@+id/widget_thermal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mx_widget_temp_placeholder"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_ram_icon"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginEnd="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_dg_memory"
                android:tint="#FFFFFFFF" />

            <TextView
                android:id="@+id/widget_ram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mx_widget_ram_placeholder"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Key Metrics Row 2 (Additional Info) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_storage_icon"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_dg_storage"
                android:tint="#FFD9D9D9" />

            <TextView
                android:id="@+id/widget_storage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mx_widget_disk_placeholder"
                android:textColor="#FFD9D9D9"
                android:textSize="9sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_network_icon"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_dg_signal"
                android:tint="#FFD9D9D9" />

            <TextView
                android:id="@+id/widget_network"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mx_widget_net_placeholder"
                android:textColor="#FFD9D9D9"
                android:textSize="9sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_power_icon"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_dg_bolt"
                android:tint="#FFD9D9D9" />

            <TextView
                android:id="@+id/widget_power"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mx_widget_drain_placeholder"
                android:textColor="#FFD9D9D9"
                android:textSize="9sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Key Metrics Row 3 (CPU & FPS) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_cpu_icon"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_dg_cpu"
                android:tint="#FFD9D9D9" />

            <TextView
                android:id="@+id/widget_cpu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mx_widget_cpu_placeholder"
                android:textColor="#FFD9D9D9"
                android:textSize="9sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_fps_icon"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_dg_speed"
                android:tint="#FFD9D9D9" />

            <TextView
                android:id="@+id/widget_fps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mx_widget_fps_placeholder"
                android:textColor="#FFD9D9D9"
                android:textSize="9sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_status_icon"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_dg_bar_chart"
                android:tint="#FFD9D9D9" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mx_widget_status_placeholder"
                android:textColor="#FFD9D9D9"
                android:textSize="9sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Compelling CTA (Psychological Trigger to Click) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <TextView
            android:id="@+id/widget_cta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mx_widget_cta_open"
            android:textColor="#FFD9FE06"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- The "go" arrow that used to be typed at the end of the text. -->
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_dg_arrow_forward"
            android:tint="#FFD9FE06" />
    </LinearLayout>

    <!-- Update Time -->
    <TextView
        android:id="@+id/widget_last_update"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#99FFFFFF"
        android:textSize="9sp"
        android:gravity="end"
        android:paddingTop="2dp" />

</LinearLayout>
