    <!-- Category simple explanation -->
    <string name="lb_cat_simple_power_efficiency">যে গাড়ি কম তেলে চলে, সেটার মতো। এই ফোনগুলোতে চার্জ কম যায়।</string>
    <string name="lb_cat_simple_cpu_performance">দৌড়ের গাড়ির মতো। এই ফোনগুলো খুব দ্রুত চলে।</string>
    <string name="lb_cat_simple_camera_efficiency">এই ফোনগুলোতে অনেক ছবি তুললেও চার্জ কম যায়।</string>
    <string name="lb_cat_simple_display_efficiency">যে বাতি কম বিদ্যুতে বেশি আলো দেয়, সেটার মতো। স্ক্রিন উজ্জ্বল, কিন্তু চার্জ কম যায়।</string>
    <string name="lb_cat_simple_health_score">ডাক্তার দেখানোর মতো। এই ফোনগুলোর অবস্থা ভালো আছে।</string>
    <string name="lb_cat_simple_power_trend">এই ফোনগুলোতে আগের চেয়ে এখন চার্জ কম যাচ্ছে।</string>
    <string name="lb_cat_simple_component_optimization">এই ফোনগুলোর কোনো একটা অংশ একা বেশি চার্জ খায় না।</string>
    <string name="lb_cat_simple_thermal_efficiency">এই ফোনগুলো অনেক কাজ করলেও বেশি গরম হয় না।</string>
    <string name="lb_cat_simple_performance_consistency">এই ফোনগুলো চলতে চলতে সহজে আটকায় না।</string>
    <string name="lb_cat_simple_app_power_monitoring">কোন অ্যাপ আপনি সবচেয়ে বেশি চালান, দেখুন।</string>
    <string name="lb_cat_simple_best_device">সব তালিকা মিলিয়ে এই ফোনগুলো সবচেয়ে বেশি নম্বর পেয়েছে।</string>

    <!-- Category: how it is measured. Bangla says what it means for the person, not the formula. -->
    <string name="lb_cat_how_power_efficiency">ফোন নিজে মেপে বলে, কত চার্জ যাচ্ছে। যে ফোনে চার্জ কম যায়, সেটা ওপরে থাকে।</string>
    <string name="lb_cat_how_cpu_performance">ফোন কত দ্রুত কাজ করে, তা মাপি। যে ফোন বেশি দ্রুত, সেটা ওপরে থাকে।</string>
    <string name="lb_cat_how_camera_efficiency">একটা ছবি তুলতে কত চার্জ যায়, তা মাপি। যে ফোনে কম যায়, সেটা ওপরে থাকে।</string>
    <string name="lb_cat_how_display_efficiency">স্ক্রিন কত উজ্জ্বল আর তাতে কত চার্জ যায়, দুটো মিলিয়ে দেখি। আলো বেশি আর চার্জ কম হলে ফোন ওপরে থাকে।</string>
    <string name="lb_cat_how_health_score">ব্যাটারি, ফাইল রাখার জায়গা আর ফোন কেমন চলছে, সব মিলিয়ে নম্বর দিই।</string>
    <string name="lb_cat_how_power_trend">কয়েক দিন ধরে চার্জ খরচ দেখি। যে ফোনে খরচ কমছে, সেটা ওপরে থাকে।</string>
    <string name="lb_cat_how_component_optimization">স্ক্রিন, নেট আর ফোনের ভেতরের অন্য অংশে চার্জ কত সমানভাবে যায়, তা দেখি।</string>
    <string name="lb_cat_how_thermal_efficiency">ভারী কাজের সময় ফোন কত গরম হয়, তা মাপি। যে ফোন ঠান্ডা থাকে, সেটা ওপরে থাকে।</string>
    <string name="lb_cat_how_performance_consistency">ফোন চলার সময় স্ক্রিনের ছবি কতটা আটকায়, তা দেখি। যে ফোন কম আটকায়, সেটা ওপরে থাকে।</string>
    <string name="lb_cat_how_app_power_monitoring">কোন অ্যাপ কতক্ষণ স্ক্রিনে খোলা ছিল, ফোন তা জানায়। সেটা দেখেই এই তালিকা। কোন অ্যাপ কত চার্জ খায়, ফোন তা আমাদের জানায় না। তাই এটা চার্জের তালিকা না।</string>
    <string name="lb_cat_how_best_device" formatted="false">সব তালিকার নম্বর মিলিয়ে একটা নম্বর বানাই। চার্জ খরচ, গতি আর ফোন কত গরম হয়, এগুলো বেশি গুরুত্ব পায়।</string>

